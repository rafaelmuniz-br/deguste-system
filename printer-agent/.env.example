# Copie para .env (o Git ignora este arquivo) e preencha. NUNCA commitar o .env: ele tem a senha do agente.

# --- Banco (mesmos valores públicos do site; a senha é da conta DO AGENTE, criada conforme docs/impressao.md)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=chave-anon-publica
AGENTE_EMAIL=cozinha@exemplo.com
AGENTE_SENHA=senha-do-agente

# --- Impressora: arquivo (só teste), rede ou windows
IMPRESSORA_TIPO=arquivo
# IMPRESSORA_TIPO=rede
# IMPRESSORA_HOST=192.168.0.50
# IMPRESSORA_PORTA=9100
# IMPRESSORA_TIPO=windows
# IMPRESSORA_NOME=COZINHA          # nome de compartilhamento no Windows, sem espaços

# Papel: 48 colunas = 80 mm; 32 colunas = 58 mm
IMPRESSORA_LARGURA=48
# cp860 = acentos do português; ascii = sem acentos (use se aparecerem símbolos estranhos no papel)
IMPRESSORA_ACENTOS=cp860
IMPRESSORA_PAGINA_CODIGO=3

# De quanto em quanto tempo olhar a fila (milissegundos)
INTERVALO_MS=3000
